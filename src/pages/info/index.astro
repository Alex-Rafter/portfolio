---
import LayoutDark from '../../layouts/LayoutDark.astro';
---

<LayoutDark title="Welcome to Astro." nav="dark">
	<main class="bg-dark text-white">

		<div class="container">
			<div class="row">
				<div class="col-12 col-lg-8 offset-lg-2">
					<h1>Info</h1>
					<article>
						<h2>HI, i'm alex</h2>
						<p>I am a front-end developer currently based in the Midlands UK.</p>
						<p>You can get in touch with me via <a href="mailto:alex@alex-m.co.uk">email</a> or <a href="https://www.linkedin.com/in/alex-m-dev/">linkedin</a>.</p>
					</article>
					<form action="/contact" method="post" class="d-flex flex-column gap-2">
						<!-- <input type="text" name="name" placeholder="name" class="form-control" /> -->
						<input type="email" name="email" placeholder="email" class="form-control" />
						<!-- <textarea name="message" placeholder="message" class="form-control"></textarea> -->
						<button type="submit" class="btn btn-primary">Send</button>
					</form>
				</div>
			</div>
		</div>

	</main>
</LayoutDark>

<style>
main {
	min-height: 100vh;
}
</style>
